<?xml version="1.0" encoding="utf-8"?>
<!--
  Backup is disabled in the manifest (allowBackup=false). These rules exist anyway so that a
  future `allowBackup=true` cannot silently export the local database: the diet records are
  personal data and must never leave the device (FF-24).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="file" path="." />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
