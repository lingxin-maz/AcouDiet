# Template for app/android/key.properties — SPEC-C-04 section 1, deliverable #2.
#
# Copy this file to `key.properties` IN THE SAME DIRECTORY (it is .gitignore'd), fill in the
# four fields, and keep the keystore itself OUTSIDE the repository.
#
#   Copy-Item app\android\key.properties.example app\android\key.properties
#
# The release build FAILS without this file (app/build.gradle throws at configuration time),
# by design: silently falling back to the debug signature would let a debug-signed artifact
# be submitted as a release deliverable.

# Absolute path to the keystore, e.g. D:\AcouDiet-Keys\acoudiet-release.jks
storeFile=C:\\path\\outside\\the\\repo\\acoudiet-release.jks

# Keystore and key passwords. Generated by keytool; recorded with the custodian (SPEC-C-04
# section 2.2 step 1) and never written into any committed file.
storePassword=__CHANGE_ME__
keyAlias=acoudiet
keyPassword=__CHANGE_ME__

# Keystore generation (RSA 2048, validity >= 25 years), run OUTSIDE the repository:
#
#   & "$env:JAVA_HOME\bin\keytool.exe" -genkeypair -v ^
#       -keystore D:\AcouDiet-Keys\acoudiet-release.jks ^
#       -alias acoudiet -keyalg RSA -keysize 2048 -validity 10000 ^
#       -dname "CN=AcouDiet, OU=Project, O=AcouDiet, L=., ST=., C=CN"
